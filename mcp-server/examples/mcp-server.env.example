# Replace these values before using docker compose.
KAGI_MCP_IMAGE=ghcr.io/changsoonkim/kagi-cli-mcp:latest
HOST_PORT=3000

# Use the full Kagi session link or the raw session token value.
KAGI_SESSION_TOKEN=https://kagi.com/search?token=replace-me

# Separate access token for MCP clients connecting to this server.
MCP_BEARER_TOKEN=replace-with-a-long-random-token
